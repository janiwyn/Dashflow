APP_NAME="Dashflow POS API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The Next.js app that owns better-auth login — the PWA authenticates against
# this server and hands the resulting session token to this API as a Bearer token.
DASHFLOW_WEB_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Points at the SAME Neon Postgres database the Next.js app uses — copy the
# real values from POS-System/.env.local's DATABASE_URL, never commit them here.
# Use Neon's DIRECT (non-pooled) host, not the "-pooler" one: the pooled PgBouncer
# endpoint can hand this app a connection left mid-transaction by an unrelated
# client, which surfaces as "current transaction is aborted" on unrelated queries.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# This API is stateless (bearer-token auth against the shared `session` table),
# so none of these need their own database tables in the shared Postgres DB.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AlieSMS (optional) — the SMS Centre stays usable without it (sends are
# logged as failed with an explanatory message instead of erroring out).
# Sign up / get credentials: https://aliesms.com
# Copy the real values from POS-System/.env.local — same business, same account.
ALIESMS_EMAIL=
ALIESMS_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
